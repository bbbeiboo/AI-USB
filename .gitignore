node_modules/
release/
production/output/
data/state.json
logs/*.log
config/*.local.json
.env
*.log

# --- Secrets / credentials (never commit) ---
.env
.env.*
*.env
auth.json
credentials*.json
tokens*.json
secrets*.json
user-config.json.bak
Launcher/Data/secrets/
Launcher/Config/user-config.json.bak
# 用户个人配置与派生模型缓存不入库（13.11）：user-config.json 含用户自选 provider/baseUrl/model，
# 模板已由根 config/providers.example.json 提供；model-cache.json 可由「拉取模型」随时再生
Launcher/Config/user-config.json
Launcher/Config/model-cache.json
**/*.pem
**/*.key

# --- Runtime state / build artifacts (never commit) ---
# Launcher 运行时机器状态：SQLite 凭据库及其 WAL/SHM、agent 状态、用量日志
Launcher/Data/
# App 以自身为 ROOT 运行时写出的嵌套状态目录
Launcher/App/Launcher/
# 运行日志目录（*.log 已在上面忽略，这里整目录排除）
Launcher/Logs/
# Vite 构建产物（renderer/.gitignore 已忽略 dist，这里再兜一层，
# 防止将来从仓库根执行 git add 时漏网）
Launcher/App/renderer/dist/

# --- 明文密钥治理（4.1.4.6，B+ 方案）---
# config/providers.json 含内置兜底供应商的明文 API Key：从索引移除并永久忽略，
# 防止将来 git add -A 误带；分发/参考模板见 config/providers.example.json
config/providers.json
# 本地备份（如 config/providers.json.bak-20261003）同样不进库
config/*.bak-*

# --- 构建产物 / 运行态目录（4.1.4.6，.gitignore 补全）---
# 注意：磁盘真实目录名是小写 build / agents，不是 Build / Agents
# 底座资产 build/Scripts/、build/Config/ 由版本控制纳管，此处【故意不忽略】
build/Release/
build/Audit/
build/Downloads/
build/Intermediate/

Runtime/
# 根锚定：agents/ 裸写法会在 Windows core.ignoreCase=true 下误杀仓库内任意
# 名为 agents 的目录（真实案例：13.12 的 renderer/src/components/agents/ 被静默忽略）
/agents/
workspace/
UserData/
browser-screenshots/
# 空占位目录，语义为备份区，预置忽略以防将来被写入后误带
backup/
